/*
 * UnityMCP Tools window
 *
 * This stylesheet deliberately uses Unity Editor semantic colour variables rather
 * than fixed theme values. That keeps the window legible in both the Dark and
 * Light editor skins, and lets built-in controls retain their native appearance.
 */

.unity-mcp-window {
    flex-grow: 1;
    min-width: 560px;
    min-height: 420px;
}

.unity-mcp-scroll {
    flex-grow: 1;
}

.unity-mcp-content {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 14px;
    padding-bottom: 18px;
}

.unity-mcp-header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 12px;
}

.unity-mcp-header__copy {
    flex-grow: 1;
    margin-right: 14px;
}

.unity-mcp-header__eyebrow {
    margin-bottom: 2px;
    font-size: 10px;
    letter-spacing: 0.8px;
    opacity: 0.7;
}

.unity-mcp-header__title {
    margin-bottom: 3px;
    font-size: 20px;
    -unity-font-style: bold;
}

.unity-mcp-header__subtitle {
    max-width: 720px;
    font-size: 12px;
    opacity: 0.72;
    white-space: normal;
}

.unity-mcp-status {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-bottom: 12px;
    border-left-width: 3px;
    border-left-color: var(--unity-colors-focus-border);
    background-color: var(--unity-colors-alternate-background);
}

.unity-mcp-status__icon {
    width: 13px;
    height: 13px;
    margin-right: 7px;
    flex-shrink: 0;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
}

.unity-mcp-status__title {
    margin-right: 7px;
    -unity-font-style: bold;
}

.unity-mcp-status__detail {
    flex-grow: 1;
    opacity: 0.76;
    white-space: normal;
}

.unity-mcp-status--stopped {
    border-left-color: var(--unity-colors-default-border);
}

.unity-mcp-status--starting {
    border-left-color: var(--unity-colors-focus-border);
}

.unity-mcp-status--running {
    border-left-color: var(--unity-colors-focus-border);
}

.unity-mcp-status--error {
    border-left-color: var(--unity-colors-focus-border);
}

.unity-mcp-nav {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.unity-mcp-nav__item {
    min-height: 28px;
    margin-right: 4px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    background-color: transparent;
    opacity: 0.75;
}

.unity-mcp-nav__item:hover {
    opacity: 1;
}

.unity-mcp-nav__item--active {
    border-bottom-color: var(--unity-colors-focus-border);
    opacity: 1;
    -unity-font-style: bold;
}

.unity-mcp-page {
    flex-grow: 1;
}

.unity-mcp-page--hidden {
    display: none;
}

.unity-mcp-stack > * {
    margin-bottom: 12px;
}

.unity-mcp-stack > *:last-child {
    margin-bottom: 0;
}

.unity-mcp-card {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 11px;
    padding-bottom: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-left-color: var(--unity-colors-default-border);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    background-color: var(--unity-colors-alternate-background);
}

.unity-mcp-card--compact {
    padding-top: 8px;
    padding-bottom: 8px;
}

.unity-mcp-card__header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 9px;
}

.unity-mcp-card__title {
    margin-bottom: 2px;
    font-size: 13px;
    -unity-font-style: bold;
}

.unity-mcp-card__description {
    max-width: 800px;
    font-size: 11px;
    opacity: 0.72;
    white-space: normal;
}

.unity-mcp-form-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 7px;
}

.unity-mcp-form-row:last-child {
    margin-bottom: 0;
}

.unity-mcp-form-row__label {
    width: 126px;
    min-width: 126px;
    margin-right: 9px;
    padding-top: 4px;
    opacity: 0.8;
}

.unity-mcp-form-row__field {
    flex-grow: 1;
    min-width: 120px;
}

.unity-mcp-inline-fields {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 7px;
}

.unity-mcp-inline-fields > * {
    flex-grow: 1;
    margin-right: 8px;
}

.unity-mcp-inline-fields > *:last-child {
    margin-right: 0;
}

.unity-mcp-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 10px;
}

.unity-mcp-action-row > * {
    margin-right: 6px;
    margin-bottom: 4px;
}

.unity-mcp-action-row > *:last-child {
    margin-right: 0;
}

.unity-mcp-primary-button {
    min-width: 92px;
    -unity-font-style: bold;
}

.unity-mcp-secondary-button {
    min-width: 78px;
}

.unity-mcp-danger-button {
    min-width: 78px;
}

.unity-mcp-button--quiet {
    opacity: 0.82;
}

.unity-mcp-button--quiet:hover {
    opacity: 1;
}

.unity-mcp-divider {
    height: 1px;
    margin-top: 10px;
    margin-bottom: 10px;
    background-color: var(--unity-colors-default-border);
}

.unity-mcp-key-value {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 5px;
}

.unity-mcp-key-value__key {
    width: 126px;
    min-width: 126px;
    margin-right: 9px;
    opacity: 0.7;
}

.unity-mcp-key-value__value {
    flex-grow: 1;
    white-space: normal;
}

.unity-mcp-empty-state {
    align-items: center;
    justify-content: center;
    min-height: 110px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
    opacity: 0.78;
}

.unity-mcp-empty-state__title {
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.unity-mcp-empty-state__description {
    max-width: 500px;
    text-align: center;
    white-space: normal;
}

.unity-mcp-tool-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding-bottom: 9px;
    margin-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.unity-mcp-tool-toolbar__search {
    flex-grow: 1;
    min-width: 170px;
    margin-right: 8px;
    margin-bottom: 4px;
}

.unity-mcp-tool-toolbar__filter {
    width: 190px;
    min-width: 190px;
    flex-shrink: 0;
    margin-right: 8px;
    margin-bottom: 4px;
}

.unity-mcp-tool-toolbar__filter > .unity-base-field__label {
    width: 48px;
    min-width: 48px;
    flex-basis: 48px;
    margin-right: 4px;
}

.unity-mcp-tool-toolbar__filter > .unity-base-field__input {
    min-width: 0;
    flex-grow: 1;
}

.unity-mcp-tool-toolbar__actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.unity-mcp-tool-toolbar__actions > * {
    margin-left: 5px;
}

.unity-mcp-tool-summary {
    margin-top: 2px;
    margin-bottom: 9px;
    font-size: 11px;
    opacity: 0.72;
}

.unity-mcp-tool-list {
    flex-direction: column;
}

.unity-mcp-tool-group {
    margin-top: 5px;
    margin-bottom: 8px;
}

.unity-mcp-tool-group__header {
    flex-direction: row;
    align-items: center;
    min-height: 25px;
    padding-left: 3px;
    padding-right: 3px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.unity-mcp-tool-group__title {
    flex-grow: 1;
    -unity-font-style: bold;
}

.unity-mcp-tool-group__count {
    font-size: 10px;
    opacity: 0.65;
}

.unity-mcp-tool-row {
    flex-direction: row;
    align-items: flex-start;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.unity-mcp-tool-row:hover {
    background-color: var(--unity-colors-alternate-background);
}

.unity-mcp-tool-row__toggle {
    margin-top: 2px;
    margin-right: 8px;
    flex-shrink: 0;
}

.unity-mcp-tool-row__content {
    flex-grow: 1;
    min-width: 0;
}

.unity-mcp-tool-row__heading {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 2px;
}

.unity-mcp-tool-row__name {
    margin-right: 6px;
    -unity-font-style: bold;
}

.unity-mcp-tool-row__description {
    font-size: 11px;
    opacity: 0.7;
    white-space: normal;
}

.unity-mcp-tool-row__meta {
    margin-top: 3px;
    font-size: 10px;
    opacity: 0.62;
    white-space: normal;
}

.unity-mcp-badge {
    min-height: 17px;
    margin-right: 4px;
    margin-bottom: 2px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 2px;
    padding-bottom: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-left-color: var(--unity-colors-default-border);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    font-size: 9px;
    -unity-font-style: bold;
    opacity: 0.78;
}

.unity-mcp-badge--enabled {
    border-color: var(--unity-colors-focus-border);
}

.unity-mcp-badge--disabled {
    opacity: 0.56;
}

.unity-mcp-badge--safe-read {
    opacity: 0.74;
}

.unity-mcp-badge--write,
.unity-mcp-badge--destructive,
.unity-mcp-badge--unsafe {
    border-color: var(--unity-colors-focus-border);
}

.unity-mcp-help {
    flex-direction: row;
    align-items: flex-start;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 9px;
    padding-bottom: 9px;
    border-left-width: 3px;
    border-left-color: var(--unity-colors-focus-border);
    background-color: var(--unity-colors-alternate-background);
}

.unity-mcp-help__icon {
    min-width: 16px;
    margin-right: 7px;
    -unity-font-style: bold;
    opacity: 0.85;
}

.unity-mcp-help__content {
    flex-grow: 1;
    white-space: normal;
    opacity: 0.82;
}

.unity-mcp-code {
    -unity-font: resource("Fonts/RobotoMono/RobotoMono-Regular");
    white-space: normal;
}

@media (max-width: 650px) {
    .unity-mcp-content {
        padding-left: 9px;
        padding-right: 9px;
    }

    .unity-mcp-header {
        flex-direction: column;
    }

    .unity-mcp-header__copy {
        margin-right: 0;
        margin-bottom: 8px;
    }

    .unity-mcp-form-row {
        flex-direction: column;
    }

    .unity-mcp-form-row__label {
        width: auto;
        min-width: 0;
        margin-right: 0;
        margin-bottom: 3px;
        padding-top: 0;
    }

    .unity-mcp-inline-fields {
        flex-direction: column;
    }

    .unity-mcp-inline-fields > * {
        width: 100%;
        margin-right: 0;
        margin-bottom: 5px;
    }

    .unity-mcp-tool-toolbar__filter {
        flex-grow: 1;
        margin-right: 0;
    }
}
