/*
 * UnityMCP Tools window
 *
 * This stylesheet deliberately uses Unity Editor semantic colour variables rather
 * than fixed theme values. That keeps the window legible in both the Dark and
 * Light editor skins, and lets built-in controls retain their native appearance.
 */

.unity-mcp-window {
    flex-grow: 1;
    min-width: 560px;
    min-height: 420px;
}

.unity-mcp-scroll {
    flex-grow: 1;
}

.unity-mcp-content {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
}

.unity-mcp-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 66px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 11px;
    padding-bottom: 11px;
    margin-bottom: 13px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-left-color: var(--unity-colors-default-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: var(--unity-colors-alternate-background);
}

.unity-mcp-header__identity {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
    margin-right: 12px;
}

.unity-mcp-brand-mark {
    width: 30px;
    height: 30px;
    min-width: 30px;
    margin-right: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--unity-colors-focus-border);
    border-right-color: var(--unity-colors-focus-border);
    border-bottom-color: var(--unity-colors-focus-border);
    border-left-color: var(--unity-colors-focus-border);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.unity-mcp-header__copy {
    flex-grow: 1;
    min-width: 0;
}

.unity-mcp-header__title {
    margin-bottom: 2px;
    font-size: 17px;
    -unity-font-style: bold;
}

.unity-mcp-header__subtitle {
    font-size: 11px;
    opacity: 0.72;
    white-space: normal;
}

.unity-mcp-header__metadata {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
}

.unity-mcp-header__metadata > * {
    margin-left: 6px;
}

.unity-mcp-status-pill,
.unity-mcp-header__tool-summary,
.unity-mcp-version-pill {
    min-height: 24px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-left-color: var(--unity-colors-default-border);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    font-size: 10px;
}

.unity-mcp-status-pill {
    flex-direction: row;
    align-items: center;
}

.unity-mcp-header__tool-summary,
.unity-mcp-version-pill {
    -unity-text-align: middle-center;
    opacity: 0.78;
}

.unity-mcp-status {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 7px;
    padding-bottom: 7px;
    margin-bottom: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-left-color: var(--unity-colors-default-border);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    background-color: var(--unity-colors-alternate-background);
}

.unity-mcp-status__icon {
    width: 10px;
    height: 10px;
    margin-right: 6px;
    flex-shrink: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

.unity-mcp-status__title {
    margin-right: 7px;
    -unity-font-style: bold;
}

.unity-mcp-status__detail {
    flex-grow: 1;
    opacity: 0.76;
    white-space: normal;
}

.unity-mcp-status--stopped {
    border-left-color: var(--unity-colors-default-border);
}

.unity-mcp-status--starting {
    border-left-color: var(--unity-colors-focus-border);
}

.unity-mcp-status--running {
    border-left-color: var(--unity-colors-focus-border);
}

.unity-mcp-status--error {
    border-left-color: var(--unity-colors-focus-border);
}

.unity-mcp-nav {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.unity-mcp-nav__item {
    min-height: 26px;
    margin-right: 2px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-left-color: var(--unity-colors-default-border);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    background-color: var(--unity-colors-alternate-background);
    opacity: 0.75;
}

.unity-mcp-nav__item:hover {
    opacity: 1;
}

.unity-mcp-nav__item--active {
    border-top-color: var(--unity-colors-focus-border);
    border-right-color: var(--unity-colors-focus-border);
    border-left-color: var(--unity-colors-focus-border);
    opacity: 1;
    -unity-font-style: bold;
}

.unity-mcp-page {
    flex-grow: 1;
}

.unity-mcp-page--hidden {
    display: none;
}

.unity-mcp-stack > * {
    margin-bottom: 10px;
}

.unity-mcp-card {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 9px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-left-color: var(--unity-colors-default-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: var(--unity-colors-alternate-background);
}

.unity-mcp-card--compact {
    padding-top: 8px;
    padding-bottom: 8px;
}

.unity-mcp-card__header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    padding-left: 2px;
    padding-right: 2px;
    padding-bottom: 8px;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.unity-mcp-card__title {
    margin-bottom: 2px;
    font-size: 13px;
    -unity-font-style: bold;
}

.unity-mcp-card__description {
    max-width: 800px;
    font-size: 11px;
    opacity: 0.72;
    white-space: normal;
}

.unity-mcp-form-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin-bottom: 8px;
}

.unity-mcp-form-row__label {
    width: 140px;
    min-width: 140px;
    margin-right: 10px;
    opacity: 0.8;
}

.unity-mcp-form-row__field {
    width: 0;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.unity-mcp-form-row__control {
    width: 100%;
    flex-grow: 1;
    min-width: 0;
}

.unity-mcp-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 8px;
}

.unity-mcp-action-row > * {
    margin-right: 6px;
    margin-bottom: 4px;
}

.unity-mcp-action-row--end {
    justify-content: flex-end;
    margin-top: 2px;
}

.unity-mcp-form-actions {
    margin-left: 150px;
    margin-top: 2px;
    margin-bottom: 8px;
}

.unity-mcp-primary-action-stack {
    margin-top: 10px;
    margin-bottom: 5px;
}

.unity-mcp-primary-action-stack > * {
    margin-bottom: 6px;
}

.unity-mcp-primary-button {
    min-width: 92px;
    -unity-font-style: bold;
}

.unity-mcp-wide-button {
    width: 100%;
    min-height: 32px;
}

.unity-mcp-secondary-button {
    min-width: 78px;
}

.unity-mcp-danger-button {
    min-width: 78px;
}

.unity-mcp-button--quiet {
    opacity: 0.82;
}

.unity-mcp-button--quiet:hover {
    opacity: 1;
}

.unity-mcp-divider {
    height: 1px;
    margin-top: 10px;
    margin-bottom: 10px;
    background-color: var(--unity-colors-default-border);
}

.unity-mcp-key-value {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 5px;
}

.unity-mcp-key-value__key {
    width: 140px;
    min-width: 140px;
    margin-right: 10px;
    opacity: 0.7;
}

.unity-mcp-key-value__value {
    flex-grow: 1;
    min-width: 0;
    white-space: normal;
}

.unity-mcp-card > .unity-foldout {
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
}

.unity-mcp-card > .unity-foldout > .unity-foldout__toggle {
    min-height: 30px;
    padding-left: 4px;
    padding-right: 4px;
}

.unity-mcp-card > .unity-foldout > .unity-foldout__content {
    margin-left: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-bottom: 4px;
}

.unity-mcp-runtime-status {
    white-space: normal;
    opacity: 0.82;
}

.unity-mcp-empty-state {
    align-items: center;
    justify-content: center;
    min-height: 110px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
    opacity: 0.78;
}

.unity-mcp-empty-state__title {
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.unity-mcp-empty-state__description {
    max-width: 500px;
    white-space: normal;
}

.unity-mcp-tool-filter-card {
    flex-shrink: 0;
}

.unity-mcp-tool-toolbar__search {
    flex-grow: 1;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.unity-mcp-tool-toolbar__filter {
    min-width: 0;
    flex-grow: 1;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.unity-mcp-tool-toolbar__actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.unity-mcp-tool-toolbar__actions > * {
    margin-right: 14px;
    margin-bottom: 4px;
}

.unity-mcp-tool-option {
    flex-direction: row-reverse;
    flex-grow: 0;
}

.unity-mcp-tool-option > .unity-base-field__label {
    width: auto;
    min-width: 0;
    flex-grow: 0;
    flex-basis: auto;
    margin-left: 5px;
}

.unity-mcp-tool-option > .unity-base-field__input {
    flex-grow: 0;
    flex-shrink: 0;
}

#unity-mcp-tool-reload {
    margin-left: auto;
}

.unity-mcp-tool-bulk-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.unity-mcp-tool-bulk-actions > * {
    min-width: 128px;
    margin-right: 6px;
    margin-bottom: 4px;
}

.unity-mcp-tool-summary {
    margin-left: 150px;
    padding-top: 7px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    font-size: 11px;
    opacity: 0.72;
}

.unity-mcp-tool-list {
    flex-direction: column;
    padding-right: 3px;
}

.unity-mcp-tool-group {
    margin-bottom: 9px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-left-color: var(--unity-colors-default-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.unity-mcp-tool-group__header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 30px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: var(--unity-colors-alternate-background);
}

.unity-mcp-tool-group__header > .unity-base-field__label {
    flex-grow: 1;
    min-width: 180px;
}

.unity-mcp-tool-group__actions {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.unity-mcp-tool-group__action {
    min-width: 80px;
    min-height: 21px;
    margin-left: 4px;
    padding-left: 6px;
    padding-right: 6px;
    font-size: 10px;
}

.unity-mcp-tool-group > .unity-foldout__content {
    margin-left: 0;
}

.unity-mcp-tool-group__title {
    flex-grow: 1;
    -unity-font-style: bold;
}

.unity-mcp-tool-group__count {
    font-size: 10px;
    opacity: 0.65;
}

.unity-mcp-tool-row {
    flex-direction: row;
    align-items: flex-start;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 9px;
    padding-bottom: 9px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.unity-mcp-tool-row:hover {
    background-color: var(--unity-colors-alternate-background);
}

.unity-mcp-tool-row__toggle {
    margin-top: 2px;
    margin-right: 8px;
    flex-shrink: 0;
}

.unity-mcp-tool-row__content {
    flex-grow: 1;
    min-width: 0;
}

.unity-mcp-tool-row__heading {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 2px;
}

.unity-mcp-tool-row__name {
    margin-right: 6px;
    -unity-font-style: bold;
}

.unity-mcp-tool-row__description {
    font-size: 11px;
    opacity: 0.7;
    white-space: normal;
}

.unity-mcp-tool-row__meta {
    margin-top: 3px;
    font-size: 10px;
    opacity: 0.62;
    white-space: normal;
}

.unity-mcp-badge {
    min-height: 17px;
    margin-right: 4px;
    margin-bottom: 2px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 2px;
    padding-bottom: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-left-color: var(--unity-colors-default-border);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    font-size: 9px;
    -unity-font-style: bold;
    opacity: 0.78;
}

.unity-mcp-badge--enabled {
    border-top-color: var(--unity-colors-focus-border);
    border-right-color: var(--unity-colors-focus-border);
    border-bottom-color: var(--unity-colors-focus-border);
    border-left-color: var(--unity-colors-focus-border);
}

.unity-mcp-badge--disabled {
    opacity: 0.56;
}

.unity-mcp-badge--safe-read {
    opacity: 0.74;
}

.unity-mcp-badge--write,
.unity-mcp-badge--destructive,
.unity-mcp-badge--unsafe {
    border-top-color: var(--unity-colors-focus-border);
    border-right-color: var(--unity-colors-focus-border);
    border-bottom-color: var(--unity-colors-focus-border);
    border-left-color: var(--unity-colors-focus-border);
}

.unity-mcp-help {
    flex-direction: row;
    align-items: flex-start;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 9px;
    padding-bottom: 9px;
    border-left-width: 3px;
    border-left-color: var(--unity-colors-focus-border);
    background-color: var(--unity-colors-alternate-background);
}

.unity-mcp-install-guide {
    margin-top: 10px;
    margin-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 8px;
    border-left-width: 3px;
    border-left-color: var(--unity-colors-focus-border);
    background-color: var(--unity-colors-alternate-background);
}

.unity-mcp-install-guide__title {
    margin-bottom: 3px;
    -unity-font-style: bold;
}

.unity-mcp-install-guide__description {
    margin-bottom: 9px;
    font-size: 11px;
    opacity: 0.78;
    white-space: normal;
}

.unity-mcp-install-guide__commands {
    margin-top: 4px;
    margin-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 7px;
    padding-bottom: 7px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-left-color: var(--unity-colors-default-border);
    white-space: normal;
}

.unity-mcp-code {
    white-space: normal;
}

@media (max-width: 650px) {
    .unity-mcp-content {
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 9px;
    }

    .unity-mcp-header {
        flex-direction: column;
        align-items: stretch;
    }

    .unity-mcp-header__identity {
        margin-right: 0;
        margin-bottom: 10px;
    }

    .unity-mcp-header__metadata {
        justify-content: flex-start;
    }

    .unity-mcp-header__metadata > * {
        margin-left: 0;
        margin-right: 6px;
        margin-bottom: 4px;
    }

    .unity-mcp-nav__item {
        flex-grow: 1;
    }

    .unity-mcp-form-row {
        flex-direction: column;
        align-items: stretch;
    }

    .unity-mcp-form-row__label {
        width: auto;
        min-width: 0;
        margin-right: 0;
        margin-bottom: 3px;
        padding-top: 0;
    }

    .unity-mcp-form-row__field {
        width: 100%;
        flex-basis: auto;
    }

    .unity-mcp-form-actions {
        margin-left: 0;
    }

    .unity-mcp-key-value {
        flex-direction: column;
    }

    .unity-mcp-key-value__key {
        width: auto;
        min-width: 0;
        margin-right: 0;
        margin-bottom: 3px;
    }

    .unity-mcp-tool-summary {
        margin-left: 0;
    }
}
